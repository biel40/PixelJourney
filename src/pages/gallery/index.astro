---
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AlbumFilter from '../../components/photo/AlbumFilter.astro';
import PhotoGrid from '../../components/photo/PhotoGrid.astro';
import Lightbox from '../../components/photo/Lightbox';
import { formatTakenAt, getGalleryPhotos } from '../../lib/gallery';
import {
  albumLabel,
  isInAlbum,
  resolveActiveAlbum,
  summarizeAlbums,
} from '../../lib/albums';
import type { LightboxSource } from '../../types/photo';

const photos = await getGalleryPhotos();
const albums = summarizeAlbums(photos);
const activeAlbum = resolveActiveAlbum(
  Astro.url.searchParams.get('album'),
  albums,
);

const visibleCount = photos.filter((photo) =>
  isInAlbum(photo, activeAlbum),
).length;

const largeImages = await Promise.all(
  photos.map((photo) =>
    getImage({ src: photo.src, width: 1600, format: 'webp' }),
  ),
);

const lightboxSources: LightboxSource[] = photos.map((photo, index) => ({
  id: photo.id,
  src: largeImages[index].src,
  alt: photo.alt,
  width: photo.src.width,
  height: photo.src.height,
  albumLabel: albumLabel(photo.album),
  dateLabel: formatTakenAt(photo.takenAt),
}));
---

<BaseLayout
  title="Galería"
  description="Colección de fotografías móviles capturadas en el día a día."
>
  <main class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div
      class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-115 overflow-hidden"
      aria-hidden="true"
    >
      <div class="gallery-glow"></div>
    </div>

    <header class="mb-8 text-center">
      <a
        href="/"
        class="reveal mb-8 inline-flex items-center gap-2 text-sm text-neutral-400 hover:text-white transition-colors"
        style="animation-delay: 60ms"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
        </svg>
        Inicio
      </a>
      <p
        class="reveal text-xs font-mono tracking-[0.3em] uppercase text-neutral-500 flex items-center justify-center gap-3"
        style="animation-delay: 140ms"
      >
        <span class="inline-block h-px w-8 bg-neutral-700"></span>
        Galería interactiva
        <span class="inline-block h-px w-8 bg-neutral-700"></span>
      </p>
      <h1
        class="reveal mt-2 text-4xl font-bold tracking-tight"
        style="animation-delay: 220ms"
        transition:name="page-title"
      >
        <span class="title-gradient">Las mejores fotografías</span>
      </h1>
      <p
        class="reveal mt-3 text-sm text-neutral-400"
        style="animation-delay: 300ms"
        data-photo-count
      >
        {visibleCount} {visibleCount === 1 ? "fotografía" : "fotografías"}
      </p>
    </header>

    {
      albums.length > 2 && (
        <div class="reveal mb-10" style="animation-delay: 380ms">
          <AlbumFilter albums={albums} activeAlbum={activeAlbum} />
        </div>
      )
    }

    {
      photos.length === 0 ? (
        <p class="text-center text-neutral-500">
          Aún no hay fotografías disponibles.
        </p>
      ) : (
        <PhotoGrid photos={photos} activeAlbum={activeAlbum} />
      )
    }
  </main>

  <Lightbox client:idle sources={lightboxSources} />
</BaseLayout>

<style>
  .gallery-glow {
    position: absolute;
    top: -120px;
    left: 50%;
    width: 620px;
    height: 420px;
    transform: translateX(-50%);
    border-radius: 9999px;
    filter: blur(100px);
    background: radial-gradient(
      circle,
      rgba(120, 113, 108, 0.28),
      transparent 70%
    );
    animation: breathe 14s ease-in-out infinite alternate;
  }

  @keyframes breathe {
    from {
      transform: translateX(-50%) scale(1);
      opacity: 0.6;
    }
    to {
      transform: translateX(-50%) scale(1.15);
      opacity: 0.9;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-glow {
      animation: none;
    }
  }
</style>
